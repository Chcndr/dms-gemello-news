# DMS MCP Connector Environment Variables

# Server Configuration
NODE_ENV=production
PORT=8080

# Security
MCP_SECRET=your-secret-token-here
ALLOWED_ORIGINS=https://chcndr.github.io,https://your-domain.com

# GitHub App Configuration
GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=789012
GITHUB_PRIVATE_KEY_PATH=/secrets/github_app.pem

# Repository Configuration
REPO_OWNER=Chcndr
REPO_NAME=dms-gemello-news

# Optional: Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret

# Optional: Logging
LOG_LEVEL=info

